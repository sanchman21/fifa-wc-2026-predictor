# Copy this file to `.env` and fill in your values. `.env` is git-ignored - never commit it.
#
# --- Kaggle (historical EA player ratings for the squad-skill factor) ---
# Create a token at https://www.kaggle.com/settings -> 'Create New Token' (downloads
# kaggle.json), then copy the two fields out of it:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
